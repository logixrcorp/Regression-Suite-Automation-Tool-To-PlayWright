# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# The D365 Finance & Operations environment. Doubles as Playwright's baseURL,
# so generated specs navigate with relative URLs.
D365_BASE_URL=https://<env>.operations.dynamics.com

# Legal entity the generated specs open against.
D365_COMPANY=USMF

# --- sign-in -----------------------------------------------------------------
# Used by the `setup` project, which signs in once per run and saves the
# session to playwright/.auth/user.json.
D365_USERNAME=
D365_PASSWORD=

# Authenticator seed, only for an account whose second factor is a TOTP code.
# Setting it switches the setup project from login.setup.ts to mfa.setup.ts.
# Print a current code with: npm run generate:otp -- <secret>
#
# Number matching and push approval cannot be automated. On those tenants leave
# this blank and capture a session by hand instead:
#   npx playwright open --save-storage=playwright/.auth/user.json <D365 URL>
D365_OTP_SECRET=
